# ===== LLM 提供方：grok | claude | openai | fake =====
LLM_PROVIDER=grok
LLM_MODEL=grok-4
# Grok（xAI，OpenAI 兼容 https://api.x.ai/v1）
XAI_API_KEY=
# Claude（Anthropic Messages API，原生 tool_use），例 LLM_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=
# 通用 OpenAI 兼容（OpenAI / DeepSeek / Kimi），例 LLM_BASE_URL=https://api.deepseek.com/v1 LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
# 可选：Tavily 搜索
TAVILY_API_KEY=
DATA_DIR=./data
AGENT_MAX_STEPS=15
# 每次运行的总工具调用上限、软期限（秒）
AGENT_MAX_TOOL_CALLS=30
AGENT_RUN_DEADLINE_S=180
# 新用户默认时区（IANA），可在页面里按用户修改；错过的定时任务在多少小时内补跑
DEFAULT_TIMEZONE=Asia/Shanghai
CATCHUP_HOURS=6
# 全局并发运行数、排队上限（手动 + 定时共用）
MAX_CONCURRENT_RUNS=2
MAX_QUEUED_RUNS=10
# 监听地址：默认只监听本机；没有鉴权，不要改成 0.0.0.0 对外开放
HOST=127.0.0.1
# 可选邮件推送（默认关闭）
SMTP_ENABLED=0
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
