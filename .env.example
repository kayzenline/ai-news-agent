# OpenAI 兼容接口（OpenAI / DeepSeek / Kimi 均可）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 不填 LLM_API_KEY 时可设 LLM_FAKE=1 用离线假模型演示
LLM_FAKE=0
# 可选：Tavily 搜索
TAVILY_API_KEY=
# 数据目录（SQLite + 每个用户的工作区）
DATA_DIR=./data
AGENT_MAX_STEPS=15
# 可选邮件推送（默认关闭）
SMTP_ENABLED=0
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
