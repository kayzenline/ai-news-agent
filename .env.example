# ===== LLM 提供方：grok | claude | openai | fake =====
LLM_PROVIDER=grok
LLM_MODEL=grok-4
# Grok（xAI，OpenAI 兼容 https://api.x.ai/v1）
XAI_API_KEY=
# Claude（Anthropic Messages API，原生 tool_use），例 LLM_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=
# 通用 OpenAI 兼容（OpenAI / DeepSeek / Kimi），例 LLM_BASE_URL=https://api.deepseek.com/v1 LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
# 可选：Tavily 搜索
TAVILY_API_KEY=
DATA_DIR=./data
AGENT_MAX_STEPS=15
# 可选邮件推送（默认关闭）
SMTP_ENABLED=0
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
